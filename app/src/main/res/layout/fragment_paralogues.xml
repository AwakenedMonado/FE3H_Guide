<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mainBackground">

    <androidx.appcompat.widget.SearchView
        android:id="@+id/paraSearchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/elevation1"
        android:theme="@style/SearchView"
        app:iconifiedByDefault="false"
        app:queryHint="Paralogue or character name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnParaAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/purpleDarkMode"
            android:text="All"
            android:textColor="@color/mainText" />

        <Button
            android:id="@+id/btnParaPart1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/purpleDarkMode"
            android:text="Part 1"
            android:textColor="@color/mainText" />

        <Button
            android:id="@+id/btnParaPart2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/purpleDarkMode"
            android:text="Part 2"
            android:textColor="@color/mainText" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/elevation1"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Route"
            android:textColor="@color/mainText"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/paraRouteSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/mainText"
            android:popupBackground="@color/elevation1" />

    </LinearLayout>

    <ListView
        android:id="@+id/listView_paralogues"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/mainBackground"
        android:dividerHeight="2dp" />

</LinearLayout>
