<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/support_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:textColor="@color/textAlt"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/support_route_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="10sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_route_tag"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/purple_accent_2"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <TextView
                android:id="@+id/support_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textColor="@color/mainText"
                android:textSize="15sp" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:layout_marginTop="18dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="2dp">

        <ImageView
            android:id="@+id/support_portrait"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop" />

    </androidx.cardview.widget.CardView>

</LinearLayout>
