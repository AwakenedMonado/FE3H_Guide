<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mainBackground">

    <androidx.appcompat.widget.SearchView
        android:id="@+id/battalionsSearchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/elevation1"
        android:theme="@style/SearchView"
        app:iconifiedByDefault="false"
        app:queryHint="Battalion name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/battalionsAllButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/purpleDarkMode"
            android:text="@string/all"
            android:textColor="@color/mainText" />

        <Button
            android:id="@+id/battalionsEButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/purpleDarkMode"
            android:text="@string/battalion_rank_e"
            android:textColor="@color/mainText" />

        <Button
            android:id="@+id/battalionsDButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/purpleDarkMode"
            android:text="@string/battalion_rank_d"
            android:textColor="@color/mainText" />

        <Button
            android:id="@+id/battalionsCButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/purpleDarkMode"
            android:text="@string/battalion_rank_c"
            android:textColor="@color/mainText" />

        <Button
            android:id="@+id/battalionsBButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/purpleDarkMode"
            android:text="@string/battalion_rank_b"
            android:textColor="@color/mainText" />

        <Button
            android:id="@+id/battalionsAButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/purpleDarkMode"
            android:text="@string/battalion_rank_a"
            android:textColor="@color/mainText" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/battalionsTypeAllButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/aqua_background"
            android:text="@string/all"
            android:textColor="@color/mainText"
            android:textSize="11sp" />

        <Button
            android:id="@+id/battalionsInfantryButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/aqua_background"
            android:text="@string/battalion_type_infantry"
            android:textColor="@color/mainText"
            android:textSize="11sp" />

        <Button
            android:id="@+id/battalionsCavalryButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/aqua_background"
            android:text="@string/battalion_type_cavalry"
            android:textColor="@color/mainText"
            android:textSize="11sp" />

        <Button
            android:id="@+id/battalionsArmoredButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/aqua_background"
            android:text="@string/battalion_type_armored"
            android:textColor="@color/mainText"
            android:textSize="11sp" />

        <Button
            android:id="@+id/battalionsFlyingButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/aqua_background"
            android:text="@string/battalion_type_flying"
            android:textColor="@color/mainText"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/elevation1"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_label"
            android:textColor="@color/mainText"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/battalionsSortSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/mainText"
            android:popupBackground="@color/elevation1" />

    </LinearLayout>

    <ListView
        android:id="@+id/listView_battalions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mainBackground"
        android:divider="@color/mainBackground"
        android:dividerHeight="2dp" />

</LinearLayout>
