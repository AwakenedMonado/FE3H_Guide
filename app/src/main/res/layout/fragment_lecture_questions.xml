<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mainBackground">

    <androidx.appcompat.widget.SearchView
        android:id="@+id/lqSearchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/elevation1"
        app:iconifiedByDefault="false"
        app:queryHint="Search by character name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnLQAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="All"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnLQPre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Part 1"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnLQPost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Part 2" />

    </LinearLayout>

    <ListView
        android:id="@+id/listView_lecture_questions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/mainBackground"
        android:dividerHeight="2dp" />

</LinearLayout>
