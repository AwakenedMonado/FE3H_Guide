<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/mainBackground"
    android:padding="16dp">

    <!-- Type icon and name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/imageView_gambit_type"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/gambit_type" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView_gambit_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mainText"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView_gambit_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mainText"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Stat labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mt"
            android:textColor="@color/mainText"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hit"
            android:textColor="@color/mainText"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/range"
            android:textColor="@color/mainText"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Stat values -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/elevation1"
        android:padding="8dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/textView_gambit_mt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/mainText"
            android:gravity="center"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textView_gambit_hit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/mainText"
            android:gravity="center"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textView_gambit_range"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/mainText"
            android:gravity="center"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Description -->
    <TextView
        android:id="@+id/textView_gambit_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/mainText"
        android:textSize="15sp"
        android:layout_marginBottom="16dp" />

    <!-- Formation image -->
    <ImageView
        android:id="@+id/imageView_gambit_formation"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/formation_image" />

</LinearLayout>
